# Шаблон скилла tnlife-miniapp-engineering: подключение к PostgreSQL.
# Норма — 01-corp-standard.md, «Файлы окружения». Подставьте ozm
# и stage; хост, пароли и корневой сертификат выдаёт служба эксплуатации при
# деплое.
#
# Имена PG* — норма §1.2 корп. шаблона, менять их нельзя. PG_MAX_CONNS (в
# .env.app), PG_MIGRATE_USER и PG_MIGRATE_PASSWORD — класс 2, канон этого файла.
# Значения по умолчанию рассчитаны на managed-кластер: SSL с проверкой сервера,
# приложение ходит через пул на порт 6432 и не имеет прав на CREATE EXTENSION.
PGHOST=REPLACE_WITH_PG_HOST
PGPORT=6432
PGDATABASE=ozm
# Рантайм-роль приложения: DML на таблицы, без DDL. Заводит служба эксплуатации.
PGUSER=ozm_stage
PGPASSWORD=REPLACE_WITH_PG_PASSWORD
# verify-full: соединение шифруется И сервер проверяется по корневому
# сертификату кластера (06-data-privacy.md §9). require шифрует, но сервер не
# проверяет — вне local конфиг его отвергает. Сертификат монтируется в
# контейнер api по этому пути (docker-compose.yaml, том ${ENV_DIR}/certs/);
# файла нет — старт падает с внятным текстом, а не на первом запросе.
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/ssl/certs/pg-root.crt
# Роль-владелец схемы: под ней идут ТОЛЬКО миграции при старте
# (migrations.Apply, пул закрывается сразу после прогона). У неё есть DDL, у
# PGUSER — нет, поэтому рантайм не может снять триггер append-only с журнала
# аудита (0001_init.up.sql, 06-data-privacy.md §5). На stage и prod роли
# ОБЯЗАНЫ различаться — конфиг и check-env.sh это проверяют; обе заводит
# служба эксплуатации (templates/project-docs/s0-requests.md).
PG_MIGRATE_USER=REPLACE_WITH_PG_MIGRATE_USER
PG_MIGRATE_PASSWORD=REPLACE_WITH_PG_MIGRATE_PASSWORD

# Локальный стенд: БД в контейнере ozm-postgres, TLS не нужен, роль
# одна — владелец и рантайм совпадают (конфиг предупреждает, но стартует).
# PGHOST=ozm-postgres
# PGPORT=5432
# PGUSER=ozm
# PGPASSWORD=REPLACE_WITH_LOCAL_PG_PASSWORD
# PGSSLMODE=disable
# PGSSLROOTCERT=
# PG_MIGRATE_USER=ozm
# PG_MIGRATE_PASSWORD=REPLACE_WITH_LOCAL_PG_PASSWORD

