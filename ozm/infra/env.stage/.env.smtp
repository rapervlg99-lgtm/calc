# Шаблон скилла tnlife-miniapp-engineering: почтовый релей продукта.
# Норма — 01-corp-standard.md, «Файлы окружения». Подставьте
# ozm и <почтовый домен>; пароль ящика — при деплое.
#
# Файл заводится, только если продукт шлёт письма. SMTP_PORT=2525 — норма §1.2
# корп. шаблона: другой порт с ВМ закрыт исходящим firewall'ом.
#
# SMTP_TLS — режим, а не булево: none | starttls | implicit. starttls
# обязателен и не даунгрейдится; implicit — TLS с первого байта (порт 465).
# Аутентификация логином и паролем допустима только поверх TLS.
SMTP_HOST=REPLACE_WITH_SMTP_RELAY_HOST
SMTP_PORT=2525
SMTP_USER=ozm@<почтовый домен>
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=ozm@<почтовый домен>
SMTP_TLS=starttls

# Локальный стенд: мок mailpit принимает любую аутентификацию без TLS.
# SMTP_HOST=ozm-mailpit
# SMTP_USER=ozm@localhost
# SMTP_PASSWORD=
# SMTP_FROM=ozm@localhost
# SMTP_TLS=none

