# Шаблон скилла tnlife-miniapp-engineering: вход через Цифровой профиль.
# Норма — 01-corp-standard.md, «Файлы окружения». Подставьте
# app.localhost; адреса эндпоинтов, client_id и client_secret выдаёт письмом
# команда Цифрового профиля, в репозитории их быть не должно.
#
# Discovery кэшируется, JWKS обновляется по TTL, подпись принимается только RS256.
# Имена OIDC_ISSUER … OIDC_PORTAL_CODE_CLAIM — класс 1 (норма §1.2 корп.
# шаблона), OIDC_TRUSTED_ISSUER — §12 корп. шаблона; остальные OIDC_* — класс 2,
# канон этого файла.

# Полный адрес token-эндпоинта Цифрового профиля — URL, на который
# auth_exchange.go шлёт POST обмена кода. Не домен провайдера и не claim iss:
# ожидаемый iss задаётся ниже, в OIDC_TRUSTED_ISSUER. Наборов эндпоинтов в
# природе несколько — берите из письма команды ЦП (Q1 в
# templates/project-docs/go-live-auth.md), догадка по домену не сработает.
# OIDC_ISSUER=REPLACE_WITH_OIDC_TOKEN_ENDPOINT_URL
# OIDC_CLIENT_ID=REPLACE_WITH_OIDC_CLIENT_ID
# OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
# Callback на тот же origin, что открыт у пользователя: HttpOnly-cookie сессии
# ставится на домен приложения, а не на домен API.
# OIDC_REDIRECT_URL=https://app.localhost/api/v1/auth/callback
# Scope НЕ подставляется по памяти: в практике встречались два противоречащих
# набора, общий в них только employee.read (он даёт claim portal_code → роль
# и для продукта с ролями обязателен; 03 §2). Строку берите из
# письма команды Цифрового профиля — открытый вопрос Q2 в
# templates/project-docs/go-live-auth.md.
# OIDC_SCOPES=REPLACE_WITH_OIDC_SCOPES
OIDC_PORTAL_CODE_CLAIM=portal_code
# Адрес authorize-эндпоинта для GET /api/v1/auth/login — вход редиректом
# (03-auth-profile.md §7). Мини-апп внутри суперапа работает без него.
# OIDC_AUTHORIZE_URL=REPLACE_WITH_OIDC_AUTHORIZE_URL
# Верификация ПОДПИСИ токена ЦП (не TLS-сертификата). Контур читается из
# APP_ENV (.env.app); норма одна на весь скилл (03-auth-profile.md §3,
# templates/project-docs/go-live-auth.md §0 и §4):
#   prod  — ровно одно из двух: OIDC_DISCOVERY_URL (предпочтительно) или
#           OIDC_JWKS_URL; OIDC_TOKEN_SIGNATURE_UNVERIFIED=true ЗАПРЕЩЁН кодом —
#           сервис не стартует. Письмо ИБ и чек-лист этот отказ не снимают.
#   stage — ровно одно из трёх; OIDC_TOKEN_SIGNATURE_UNVERIFIED=true — только
#           по письменному решению ИБ с планом снятия и только с
#           зарегистрированной метрикой
#           ozm_auth_profile_token_unverified_total, иначе старт падает.
#   local — ровно одно из трёх, отказ от подписи — под мок OIDC (блок ниже).
# Ноль признаков или два сразу — отказ старта на любом контуре.
# OIDC_DISCOVERY_URL=REPLACE_WITH_OIDC_DISCOVERY_URL
# OIDC_JWKS_URL=REPLACE_WITH_OIDC_JWKS_URL
# true — явный отказ от проверки ПОДПИСИ токена: только stage (см. выше) и
# local. На prod значение true отвергается на старте. Если ЦП ключи не
# публикует (Q3), для prod это блокер к ИБ и команде ЦП, а не повод для true:
# альтернатива — introspection или подтверждённый TLS-канал, решается ADR.
# После появления ключей метрика непроверенных разборов обязана стоять на нуле.
# Имя OIDC_INSECURE_SKIP_VERIFY запрещено (01-corp-standard.md, таблица
# синонимов): оно встречается и в значении пропуска проверки TLS-сертификата
# самоподписанного мока — одно имя, два смысла. Перенесли .env.oidc с этим
# именем — переименуйте; check-env.sh его отвергает.
# OIDC_TOKEN_SIGNATURE_UNVERIFIED=false

# Ожидаемый издатель токена: сверяется с claim iss. Имя одно на весь скилл —
# OIDC_TRUSTED_ISSUER, каноническое по §12 корп. шаблона (OIDC_ISSUER выше —
# адрес token-эндпоинта, это разные вещи). Синонимы OIDC_EXPECTED_ISSUER и
# SSO_TRUSTED_ISS ЗАПРЕЩЕНЫ (01-corp-standard.md, таблица синонимов;
# check-env.sh их отвергает).
# OIDC_TRUSTED_ISSUER=REPLACE_WITH_OIDC_TRUSTED_ISSUER
# Необязательные, задавайте явно (03-auth-profile.md, матрица переменных):
# OIDC_AUDIENCE — аудитория токена контура (пусто — сверяется с OIDC_CLIENT_ID),
# OIDC_JWKS_CACHE_TTL — TTL кэша ключей (пусто — 1h).
# OIDC_AUDIENCE=REPLACE_WITH_OIDC_AUDIENCE
# OIDC_JWKS_CACHE_TTL=1h


# Локальный стенд: мок OIDC за локальным прокси (ISSUER_URL мока в
# docker-compose.yaml — https://oidc.localhost/default). Хост один и тот же
# для браузера и для бэкенда — иначе не сойдётся claim iss. Тем же блоком
# живёт stage, пока ЦП не ответил (03-auth-profile.md §8): мок там включается
# профилем compose oidc-mock и снимается вместе с
# OIDC_TOKEN_SIGNATURE_UNVERIFIED; на stage отказ от подписи стартует только
# с зарегистрированной метрикой (см. выше). Доверие самоподписанному
# сертификату прокси — не переменная приложения: сертификат стенда монтируется
# в контейнер api и объявляется через SSL_CERT_FILE (docker-compose.yaml).
OIDC_ISSUER=https://oidc.localhost/default/token
OIDC_TRUSTED_ISSUER=https://oidc.localhost/default
OIDC_CLIENT_ID=ozm-web
OIDC_CLIENT_SECRET=REPLACE_WITH_LOCAL_MOCK_SECRET
OIDC_REDIRECT_URL=https://app.localhost/api/v1/auth/callback
# Ниже scope самого мока, а не контракт Цифрового профиля (см. Q2).
OIDC_SCOPES=openid profile email
# На local признак из трёх — только этот: закомментируйте OIDC_DISCOVERY_URL
# выше, иначе в конфиге окажется два признака сразу.
OIDC_TOKEN_SIGNATURE_UNVERIFIED=true
OIDC_AUTHORIZE_URL=https://oidc.localhost/default/authorize

