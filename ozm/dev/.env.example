# Postgres. Имена — канонические из §12 корп. шаблона («Файлы окружения»), те же,
# что в контурах infra/env.<контур>/.env.pg: их читает backend/internal/envconfig.
# Локальный запуск без Docker (go run) ходит на localhost, порт стенда — 5432.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=ozm
PGPASSWORD=ozm
PGDATABASE=ozm
PGSSLMODE=disable
# Для managed PG с проверкой сервера (этап/прод): PGSSLMODE=verify-full и путь к
# корневому сертификату.
# PGSSLROOTCERT=/etc/ssl/certs/pg-root.crt
# Роль владельца схемы: миграции идут под ней, рантайм — под PGUSER. На стенде
# роли совпадают, поэтому переменные не заданы.
# PG_MIGRATE_USER=ozm_migrate
# PG_MIGRATE_PASSWORD=

# HTTP / runtime
HTTP_ADDR=:8080
LOG_LEVEL=info
CALC_OZM_APP_ADMIN_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CALC_OZM_APP_ENABLE_API_DOCS=false
CALC_OZM_APP_ENABLE_METRICS=false
CALC_OZM_APP_LOG_PERF=false

# Dicts baseline (migrate / local go run)
DICTS_BASELINE_DIR=../backend/dicts

# OCR / recognition. Default off — calc works without OCR deps.
CALC_OZM_APP_OCR_ENABLED=false
CALC_OZM_APP_AUTH_DEV_MODE=true
CALC_OZM_APP_STORAGE_DIR=./data/blobs
CALC_OZM_APP_MAX_UPLOAD_BYTES=31457280
CALC_OZM_APP_VISION_PROVIDER=ollama
CALC_OZM_APP_OLLAMA_URL=http://localhost:11434
CALC_OZM_APP_OLLAMA_MODEL=qwen3.5:9b
CALC_OZM_APP_OLLAMA_TIMEOUT=180s
CALC_OZM_APP_OLLAMA_NUM_CTX=32768
CALC_OZM_APP_OLLAMA_NUM_PREDICT=8192
CALC_OZM_APP_OLLAMA_KEEP_ALIVE=30m
CALC_OZM_APP_OPENROUTER_URL=https://openrouter.ai/api/v1
CALC_OZM_APP_OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
# CALC_OZM_APP_OPENROUTER_API_KEY=   # secret — never commit
CALC_OZM_APP_OPENROUTER_TIMEOUT=120s
CALC_OZM_APP_RECOGNITION_DPI=220
CALC_OZM_APP_VISION_MAX_EDGE=2048
CALC_OZM_APP_PDFTOPPM_BIN=pdftoppm
CALC_OZM_APP_PIPELINE_CONCURRENCY=1

# For docker-compose.yml (prod-like): POSTGRES_* наполняет контейнер postgres,
# PGUSER/PGPASSWORD бэкенд берёт из PG*-блока выше — значения должны совпадать.
POSTGRES_PASSWORD=ozm
POSTGRES_USER=ozm
POSTGRES_DB=ozm
