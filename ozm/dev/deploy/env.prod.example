# Переменные для dev/docker-compose.yml (сервер). Скопировать в dev/.env и заполнить.
# Секреты не коммитить. Генерация: openssl rand -hex 24

# --- обязательные ---
POSTGRES_PASSWORD=CHANGE_ME
# токен, который фронтенд шлёт бэкенду; nginx пропускает в /api/ только его
API_TOKEN=CHANGE_ME

# --- адрес ---
# Порт HTTP на сервере. Без TLS ссылка будет http://<ip-или-домен>:<HOST_PORT>/
HOST_PORT=80
# С TLS (profile tls, нужен домен): фронт слушает только локально, наружу — Caddy
# HOST_PORT=127.0.0.1:8081
# PUBLIC_DOMAIN=calc.example.ru

# --- OCR ---
# Каталог с *.ttf чертёжных шрифтов (ISOCPEUR, GOST type A/B, GOST Common) —
# шаблоны глифов для листов без текстового слоя. Скопировать с Windows-машины.
OCR_FONTS_DIR=./deploy/fonts

# --- бэкенд ---
# Собственной аутентификации у бэкенда пока нет (OIDC — TODO в auth.go), поэтому
# dev-режим остаётся включённым, а вход закрыт паролем nginx (deploy/htpasswd).
CALC_OZM_APP_AUTH_DEV_MODE=true
CALC_OZM_APP_OCR_ENABLED=true
LOG_LEVEL=info
CALC_OZM_APP_ADMIN_TOKEN=

# --- Postgres ---
# Имена канонические (§12 корп. шаблона), их читает backend/internal/envconfig.
# POSTGRES_PASSWORD выше наполняет контейнер postgres; PGPASSWORD — подключение
# бэкенда: значения обязаны совпадать.
PGHOST=ozm-postgres
PGPORT=5432
PGUSER=ozm
PGPASSWORD=CHANGE_ME
PGDATABASE=ozm
PGSSLMODE=disable
# Managed PG с проверкой сервера: PGSSLMODE=verify-full, PGSSLROOTCERT — путь к
# корневому сертификату внутри контейнера (том монтирует compose).
# PG_MIGRATE_USER=ozm_migrate
# PG_MIGRATE_PASSWORD=CHANGE_ME
