.DS_Store
Thumbs.db
*.log
.env
.env.*
!.env.example
# Контуры поставки — часть нормы, а не личные переопределения: их читают
# infra/docker-compose.yaml, проверки [3/15] и [8/15] и tests/check-env.sh.
# В stage и prod в них только плейсхолдеры REPLACE_WITH_* (их и ловит
# .gitleaks.toml); личные значения разработчика лежат в dev/.env — он остаётся
# игнорируемым.
!infra/env.local/.env.*
!infra/env.stage/.env.*
!infra/env.prod/.env.*
node_modules/
frontend/dist/
backend/bin/
backend/data/
**/__pycache__/
progress.md
tasks/
.idea/
.vscode/
*.exe
dev/tmp/
dev/results/
# Рабочие копии словарей (roll.json.bak и подобные) — местный инструмент
# сопровождения справочника, в репозитории им делать нечего.
*.bak

# Ключи и сертификаты локального стенда: local.crt/local.key генерирует первый
# `make -C infra up` (шаг up Makefile набора). Корневой сертификат managed PG
# (env.<контур>/certs/pg-root.crt) — публичный, он в репозитории и под *.pem
# не попадает.
infra/env.local/traefik/certs/local.crt
infra/env.local/traefik/certs/local.key
*.key
*.pem

# Настройки агентов и редакторов — локальные
.claude/
.cursor/
**/.claude/
**/.cursor/
